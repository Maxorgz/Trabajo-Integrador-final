extends layout

block content
  div(class="max-w-6xl mx-auto py-8 px-4 h-[calc(100vh-80px)] flex flex-col")
    h2(class="text-3xl font-bold text-white mb-6 flex items-center gap-3 shrink-0") 
      span 📬 
      | Bandeja de Mensajes
    
    if conversaciones.length === 0
      div(class="bg-black/40 border border-white/10 p-10 rounded-2xl text-center backdrop-blur-sm shadow-xl")
        p(class="text-gray-400 text-lg font-semibold") No tienes mensajes.
        p(class="text-sm text-gray-500 mt-2") La conversacion aparece aqui.
    
    else
      //contenedor 2 columnas
      div(class="flex flex-col md:flex-row gap-6 flex-1 min-h-0")
        
        //contactos
        div(class="w-full md:w-1/3 bg-gray-900/80 border border-gray-700 rounded-2xl overflow-y-auto shadow-lg backdrop-blur-xl flex flex-col")
          div(class="p-4 border-b border-gray-700 bg-gray-800/50 sticky top-0 z-10")
            h3(class="text-white font-bold m-0") Tus Conversaciones
          
          div(class="flex flex-col")
            each chat, index in conversaciones
              //pestaña chat
              button(id=`tab-${index}` onclick=`abrirChat(${index})` class=`chat-tab w-full text-left p-4 border-b border-gray-700/50 hover:bg-gray-800 transition-colors flex items-center gap-3 border-l-4 ${index === 0 ? 'bg-cyan-900/40 border-cyan-400' : 'border-transparent'}`)
                div(class="w-10 h-10 rounded-full bg-gradient-to-tr from-orange-400 to-red-500 flex items-center justify-center text-white font-bold shadow-md shrink-0")
                  | #{chat.otroUsuario.nombre_usuario.charAt(0).toUpperCase()}
                div(class="overflow-hidden flex-1")
                  h4(class="text-white font-bold text-sm m-0 truncate") #{chat.otroUsuario.nombre_usuario}
                  if chat.publicacion
                    p(class="text-gray-400 text-xs m-0 truncate mt-1") 📸 #{chat.publicacion.titulo}

        //chat artivo
        div(class="w-full md:w-2/3 bg-gray-900/90 border border-cyan-500/30 rounded-2xl overflow-hidden shadow-[0_10px_30px_-10px_rgba(6,182,212,0.2)] backdrop-blur-xl relative flex flex-col")
          
          each chat, index in conversaciones
            //caja chat
            div(id=`chat-${index}` class=`chat-caja flex flex-col h-full ${index === 0 ? 'flex' : 'hidden'}`)
              
              //cabecera del chat
              div(class="bg-gray-800/80 p-4 border-b border-white/10 flex justify-between items-center shrink-0")
                div(class="flex items-center gap-3")
                  div(class="w-12 h-12 rounded-full bg-gradient-to-tr from-orange-400 to-red-500 flex items-center justify-center text-white font-bold text-xl shadow-lg")
                    | #{chat.otroUsuario.nombre_usuario.charAt(0).toUpperCase()}
                  div
                    p(class="text-gray-400 text-xs uppercase tracking-widest font-semibold m-0") Charlando con
                    h3(class="text-white font-bold text-lg m-0 mt-0.5") #{chat.otroUsuario.nombre_usuario}
              
              //histial
              div(class="p-6 flex-1 overflow-y-auto flex flex-col gap-4 bg-black/40")
                if chat.publicacion
                  div(class="self-center flex flex-col items-center bg-gray-800/80 border border-gray-600/50 p-2 rounded-2xl shadow-lg mb-4 max-w-[250px]")
                    p(class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mb-2 mt-1") Negociando por
                    a(href=`/foto/${chat.publicacion.id}` class="block overflow-hidden rounded-xl w-full relative group")
                      if chat.publicacion.imagenes && chat.publicacion.imagenes.length > 0
                        img(src=chat.publicacion.imagenes[0].url_imagen alt=chat.publicacion.titulo class="w-full h-40 object-cover group-hover:scale-110 transition-transform duration-500")
                      else if chat.publicacion.Imagenes && chat.publicacion.Imagenes.length > 0
                        img(src=chat.publicacion.Imagenes[0].url_imagen alt=chat.publicacion.titulo class="w-full h-40 object-cover group-hover:scale-110 transition-transform duration-500")
                      else
                        div(class="w-full h-40 bg-gray-700 flex items-center justify-center text-4xl group-hover:bg-gray-600 transition-colors") 🖼️
                      div(class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center")
                        span(class="text-white text-2xl drop-shadow-lg") 🔗
                    if chat.publicacion.titulo
                      span(class="text-xs font-semibold text-gray-200 mt-2 truncate w-full text-center px-2")= chat.publicacion.titulo

                //historial de mensaje
                each msj in chat.mensajes
                  if msj.emisor_id === usuario.id
                    //mi mensaje
                    div(class="self-end bg-cyan-600/90 text-white p-4 rounded-2xl rounded-tr-sm max-w-[80%] sm:max-w-[70%] shadow-md border border-cyan-500/50")
                      p(class="text-sm m-0 leading-relaxed")= msj.texto
                      span(class="text-[10px] text-cyan-200 block mt-2 text-right font-semibold tracking-wider") #{new Date(msj.fecha_envio).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}
                  else
                    //- Mensaje de la otra persona
                    div(class="self-start bg-gray-800 border border-gray-600/50 text-white p-4 rounded-2xl rounded-tl-sm max-w-[80%] sm:max-w-[70%] shadow-md")
                      p(class="text-sm m-0 leading-relaxed text-gray-200")= msj.texto
                      span(class="text-[10px] text-gray-400 block mt-2 font-semibold tracking-wider") #{new Date(msj.fecha_envio).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}
              
              //formulario respuesta
              form(action="/mis-mensajes/responder" method="POST" class="p-4 bg-gray-800/80 border-t border-white/10 flex gap-3 items-center shrink-0")
                input(type="hidden" name="receptor_id" value=chat.otroUsuario.id)
                if chat.publicacion
                  input(type="hidden" name="publicacion_id" value=chat.publicacion.id)
                textarea(name="texto" required rows="1" placeholder="Escribe una respuesta..." class="flex-1 px-4 py-3 bg-black/50 text-white border border-gray-600 rounded-xl outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all placeholder-gray-500 resize-none")
                button(type="submit" class="px-6 py-3 bg-cyan-600 hover:bg-cyan-500 text-white font-bold rounded-xl transition-all shadow-lg flex items-center justify-center gap-2 hover:scale-105") 
                  span Enviar
                  span 🚀

  script.
    function abrirChat(indexClickeado) {
      //oculta historial
      document.querySelectorAll('.chat-caja').forEach(caja => {
        caja.classList.remove('flex');
        caja.classList.add('hidden');
      });
      
      //apaga pestaña 
      document.querySelectorAll('.chat-tab').forEach(tab => {
        tab.classList.remove('bg-cyan-900/40', 'border-cyan-400');
        tab.classList.add('border-transparent');
      });
      
      //enciende historial clickeado
      document.getElementById('chat-' + indexClickeado).classList.remove('hidden');
      document.getElementById('chat-' + indexClickeado).classList.add('flex');
      
      //ilumina pestaña 
      document.getElementById('tab-' + indexClickeado).classList.remove('border-transparent');
      document.getElementById('tab-' + indexClickeado).classList.add('bg-cyan-900/40', 'border-cyan-400');
    }