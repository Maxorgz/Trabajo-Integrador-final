extends layout

block metadata
  title #{coleccion.nombre} | Coleccion
  script(src="https://cdn.tailwindcss.com")

block content
  div(class="relative min-h-screen bg-[url('https://images.unsplash.com/photo-1554034483-04fda0d3507b?q=80&w=1920&auto=format&fit=crop')] bg-cover bg-center bg-no-repeat bg-fixed py-6 sm:py-10 px-4 sm:px-6 lg:px-8")
    
    div(class="absolute inset-0 bg-gray-900/85 z-0")

    // Contenedor principal
    div(class="relative z-10 max-w-screen-2xl mx-auto")
      
      div(class="mb-8 flex flex-col sm:flex-row justify-between items-center gap-4 bg-white/5 backdrop-blur-xl border border-white/10 p-6 sm:p-8 rounded-3xl shadow-2xl")
        div(class="flex items-center gap-4")
          
          
          a(href="/colecciones" class="w-12 h-12 bg-black/40 hover:bg-cyan-600 border border-white/20 hover:border-cyan-400 rounded-xl flex items-center justify-center text-white transition-all shadow-md group no-underline")
            span(class="group-hover:-translate-x-1 transition-transform text-xl") &larr;
          
          div
            h1(class="text-3xl sm:text-4xl font-bold text-white tracking-wide drop-shadow-md m-0 flex items-center gap-3") 
              | 📂 #{coleccion.nombre}
            p(class="text-cyan-400 text-sm mt-2 font-medium m-0") 
              if coleccion.publicaciones
                | #{coleccion.publicaciones.length} publicaciones guardadas
              else
                | 0 publicaciones guardadas

      if coleccion.publicaciones && coleccion.publicaciones.length > 0
        div(class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6")
          
          each publicacion in coleccion.publicaciones
            
            div(class="bg-white/5 backdrop-blur-xl rounded-2xl border border-white/10 overflow-hidden shadow-2xl hover:border-cyan-500/50 hover:-translate-y-1 transition-all duration-300 group flex flex-col")
              
              div(class="relative w-full h-64 bg-black/60 overflow-hidden flex items-center justify-center")
                if publicacion.imagenes && publicacion.imagenes.length > 0
                  img(src=publicacion.imagenes[0].url_imagen alt="Foto" class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700")
                else
                  span(class="text-gray-500") Sin imagen
                
                div(class="absolute inset-0 bg-gradient-to-t from-gray-900 via-transparent to-transparent opacity-60")
              
              div(class="p-5 flex-1 flex flex-col justify-between relative z-10 bg-black/20")
                div(class="mb-4")
                  if publicacion.Usuario
                    p(class="text-xs text-gray-400 uppercase tracking-wider mb-1 font-semibold m-0") Autor
                    p(class="text-white font-bold text-sm truncate m-0")= publicacion.Usuario.nombre_usuario
                
                a(href=`/foto/${publicacion.id}` class="w-full block text-center py-2.5 bg-white/10 hover:bg-cyan-600 backdrop-blur border border-white/20 hover:border-cyan-400 text-gray-200 hover:text-white font-bold rounded-lg transition-all shadow-md mt-auto no-underline")
                  | Ver Foto &rarr;

      else
       
        div(class="w-full py-20 flex flex-col items-center justify-center bg-white/5 backdrop-blur-xl rounded-3xl border border-white/10 shadow-2xl text-center px-4")
          div(class="text-6xl mb-4 grayscale opacity-50") 📭
          h3(class="text-2xl font-bold text-white mb-2") Coleccion vacia
          p(class="text-gray-400 max-w-md mx-auto mb-6") Aun no se guardo ninguna foto en esta coleccion.
          a(href="/" class="px-6 py-3 bg-cyan-600 hover:bg-cyan-500 text-white font-bold rounded-xl transition-all shadow-lg hover:shadow-cyan-500/25 no-underline") 
            | Explorar fotos