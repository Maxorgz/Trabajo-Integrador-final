extends layout

block metadata 
    title Registrarse 
    script(src="https://cdn.tailwindcss.com")

block content

  div(class="min-h-[calc(100vh-4rem)] w-full flex items-center justify-center p-4 py-10")
    
    div(class="max-w-5xl w-full flex flex-col md:flex-row bg-gray-900/60 backdrop-blur-xl border border-gray-800 rounded-3xl overflow-hidden shadow-2xl")
      div(class="w-full md:w-1/2 p-10 lg:p-14 flex flex-col justify-center relative overflow-hidden bg-gradient-to-br from-gray-900 to-black")

        div(class="absolute top-0 left-0 w-full h-full bg-cyan-900/10 pointer-events-none")
        
        h1(class="text-5xl lg:text-7xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-blue-500 mb-2 relative z-10 tracking-tight") Fotaza
        h2(class="text-2xl lg:text-3xl font-bold text-white mb-6 relative z-10") Imágenes que cuentan
        p(class="text-gray-400 text-lg mb-10 leading-relaxed max-w-sm relative z-10") Descubre, comparte y compra las mejores fotos. Únete a nuestra comunidad de fotógrafos hoy mismo. ¡Regístrate ahora!

        a(href="/" class="relative z-10 inline-flex items-center gap-2 w-max px-6 py-3 bg-white/5 hover:bg-white/10 border border-white/10 text-white font-semibold rounded-full transition-all shadow-lg hover:-translate-y-1 no-underline group")
          svg(class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18")
          | Volver al Inicio

      div(class="w-full md:w-1/2 p-8 lg:p-14 bg-black/40 border-l border-gray-800 relative")
        
        a(href="/" class="absolute top-6 right-6 text-gray-500 hover:text-white transition-colors bg-gray-800/50 hover:bg-gray-700 p-2 rounded-full")
          svg(class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor")
            path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12")

        h3(class="text-3xl font-bold text-white mb-8") Regístrate
        
        form(action="/auth/register" method="POST" class="flex flex-col gap-5")
          
          div(class="grid grid-cols-1 sm:grid-cols-2 gap-5")

            div(class="relative")
              input#nombre(type="text" name="nombre_usuario" required placeholder=" " class="peer w-full bg-gray-900/50 border border-gray-700 text-white rounded-xl px-4 pt-6 pb-2 outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all [&:-webkit-autofill]:[-webkit-text-fill-color:#fff] [&:-webkit-autofill]:[transition:background-color_5000s]")
              label(for="nombre" class="absolute left-4 top-4 text-gray-500 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:top-4 peer-focus:top-1.5 peer-focus:text-xs peer-focus:text-cyan-400 peer-[:not(:placeholder-shown)]:top-1.5 peer-[:not(:placeholder-shown)]:text-xs cursor-text") Nombre

            div(class="relative")
              input#apellido(type="text" name="apellido_usuario" required placeholder=" " class="peer w-full bg-gray-900/50 border border-gray-700 text-white rounded-xl px-4 pt-6 pb-2 outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all [&:-webkit-autofill]:[-webkit-text-fill-color:#fff] [&:-webkit-autofill]:[transition:background-color_5000s]")
              label(for="apellido" class="absolute left-4 top-4 text-gray-500 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:top-4 peer-focus:top-1.5 peer-focus:text-xs peer-focus:text-cyan-400 peer-[:not(:placeholder-shown)]:top-1.5 peer-[:not(:placeholder-shown)]:text-xs cursor-text") Apellido

          div(class="relative")
            input#email(type="email" name="email" required placeholder=" " class="peer w-full bg-gray-900/50 border border-gray-700 text-white rounded-xl px-4 pt-6 pb-2 outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all [&:-webkit-autofill]:[-webkit-text-fill-color:#fff] [&:-webkit-autofill]:[transition:background-color_5000s]")
            label(for="email" class="absolute left-4 top-4 text-gray-500 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:top-4 peer-focus:top-1.5 peer-focus:text-xs peer-focus:text-cyan-400 peer-[:not(:placeholder-shown)]:top-1.5 peer-[:not(:placeholder-shown)]:text-xs cursor-text") Correo Electrónico

          div(class="relative")
            input#password(type="password" name="password" required placeholder=" " class="peer w-full bg-gray-900/50 border border-gray-700 text-white rounded-xl px-4 pt-6 pb-2 outline-none focus:border-cyan-400 focus:ring-1 focus:ring-cyan-400 transition-all [&:-webkit-autofill]:[-webkit-text-fill-color:#fff] [&:-webkit-autofill]:[transition:background-color_5000s]")
            label(for="password" class="absolute left-4 top-4 text-gray-500 text-sm transition-all peer-placeholder-shown:text-base peer-placeholder-shown:top-4 peer-focus:top-1.5 peer-focus:text-xs peer-focus:text-cyan-400 peer-[:not(:placeholder-shown)]:top-1.5 peer-[:not(:placeholder-shown)]:text-xs cursor-text") Contraseña

          div(class="mt-2 text-center sm:text-left")
            span(class="text-gray-400 text-sm") ¿Ya tienes una cuenta? 
            a(href="/auth/login" class="text-cyan-400 hover:text-cyan-300 font-semibold transition-colors no-underline") Inicia Sesión

          //- Submit
          button(type="submit" class="w-full mt-4 py-3.5 bg-gradient-to-r from-cyan-600 to-blue-600 hover:from-cyan-500 hover:to-blue-500 text-white font-bold rounded-xl shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 transition-all duration-300 hover:-translate-y-0.5 tracking-wide") CREAR CUENTA