extends layout

block metadata
  title Subir Nueva Foto
  script(src="https://cdn.tailwindcss.com")
block content 
  //- Contenedor principal
  div(class="w-full flex justify-center py-1")
    
    
    div(class="w-full max-w-2xl bg-white p-8 rounded-lg shadow-xl relative")
      div(class="absolute top-3 right-5 pt-3 pr-3")
          a(href="/" style="color: inherit; text-decoration: none;" title="Cerrar")
           svg(width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg")
              path(fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z")



      p.text-4xl.font-bold.text-gray-800.text-center.mb-8 Compartir nueva foto
       
        // Formulario
      form(action="/nuevaFoto" method="POST" class="flex flex-col gap-4")
        
        div(class="flex flex-col")
          label(for="foto_local" class="font-bold text-gray-700 mb-2") Sube tu foto (Solo JPG o PNG):
          input(type="file" id="fotos_locales" accept="image/jpeg, image/png" multiple required class="block w-full text-sm text-gray-500 file:mr-4 file:py-3 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-[#5b13b9] file:text-white hover:file:bg-[#9056c7] file:cursor-pointer cursor-pointer border border-gray-300 rounded-md bg-gray-50 p-1 transition")
          input(type="hidden" name="url_imagen" id="url_imagen_base64")
        
        div(class="flex flex-col")
          label(for="titulo" class="font-bold text-gray-700 mb-1") Título:
          input(type="text" name="titulo" id="titulo" minlength="3" maxlength="150" required class="w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500")

        div(class="flex flex-col")
          label(for="descripcion" class="font-bold text-gray-700 mb-1") Descripción:
          textarea(name="descripcion" id="descripcion" rows="4" class="w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500 resize-none")

        div(class="flex flex-col mt-2")
          label(class="font-bold text-gray-700") Etiquetas (Selecciona al menos una):
          
          //- Contenedor de etiquetas
          div(class="flex gap-3 flex-wrap mt-2")
            if etiquetas
              each etiqueta in etiquetas
                label(class="bg-orange-50 hover:bg-orange-100 text-orange-900 px-3 py-1 rounded-full cursor-pointer border border-orange-800 transition text-sm flex items-center")
                  input(type="checkbox" name="etiquetas[]" value=etiqueta.id class="mr-2 cursor-pointer accent-orange-700")
                  | #{etiqueta.nombre}
      
        div(class="flex flex-col mt-2")
          label(for="nuevas_etiquetas" class="font-bold text-gray-700 mb-1") Ingresar etiquetas (separadas por coma):
          input(type="text" name="nuevas_etiquetas" id="nuevas_etiquetas" placeholder="Ej: Etiqueta1, Etiqueta2" class="w-full p-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-purple-500")

        div#contenedor_base64

        //- Botón de envío
        button(type="submit" class="mt-4 bg-gray-800 hover:bg-gray-900 text-white font-semibold py-3 px-4 rounded-md transition shadow-lg cursor-pointer") Publicar Foto

block scripts
  script.
    const inputFotos = document.getElementById('fotos_locales');
    const contenedorBase64 = document.getElementById('contenedor_base64');

    inputFotos.addEventListener('change', function(event) {
      contenedorBase64.innerHTML = '';
      Array.from(event.target.files).forEach((archivo, index) => {
        const reader = new FileReader();
        reader.onload = function(e) {
          const inputOculto = document.createElement('input');
          inputOculto.type = 'hidden';
          inputOculto.name = 'imagenes_base64[]';
          inputOculto.value = e.target.result;
          contenedorBase64.appendChild(inputOculto);
        };
        reader.readAsDataURL(archivo);
      });  
    });