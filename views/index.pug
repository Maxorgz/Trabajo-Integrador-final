
extends layout.pug
block metadata
    title Home - Fotaza
    script(src="https://cdn.tailwindcss.com")
block content

    h1.text-3xl.font-bold.text-white.text-center Bienvenido a mi sitio web
    p.text-100xl.text-gray-300
      | Bienvenido a Fotaza. Sube, comparte y explora las mejores galerías en alta resolución. Tu próxima gran foto está aquí.
    
    div(class="flex flex-col gap-2")
     p(class="bg-[#5b13b9] hover:bg-[#9056c7] text-white px-2 py-3 rounded-full text-center font-semibold transition shadow-lg shadow-purple-900/50")
       a(href="/login") Iniciar Sesión
     
     p(href="/nuevaFoto" class="bg-[#5b13b9] hover:bg-[#9056c7] text-white px-2 py-3 rounded-full text-center font-semibold transition shadow-lg shadow-purple-900/50")
        a(href="/nuevaFoto") Subir Foto
     
     p(href="/mi-perfil" class="bg-[#5b13b9] hover:bg-[#9056c7] text-white px-2 py-3 rounded-full text-center font-semibold transition shadow-lg shadow-purple-900/50")
        a(href="/mi-perfil") Mi Perfil
     
      
     div.contenedor-principal
        aside.sidebar
          h3 Categorias
          ul
            li
              
          h3 Ordenar por
          ul
            li
              // filtros de ordenamiento
              a(href=`/?categoria=${filtrosActuales.categoriaSeleccionada || ''}&orden=recientes` class=(!filtrosActuales.orden || filtrosActuales.orden !== 'antiguas' ? "activo" : "")) Más recientes
            li
              a(href=`/?categoria=${filtrosActuales.categoriaSeleccionada || ''}&orden=antiguas` class=(filtrosActuales.orden === 'antiguas' ? "activo" : "")) Más antiguas
         
               main(class="columns-2 md:columns-4 gap-4 p-4 w-full max-w-7xl mx-auto")
                 if fotos && fotos.length > 0
                   each foto in fotos
                     a(href=`/foto/${foto.id}` class="break-inside-avoid block mb-4 bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-md hover:-translate-y-1 transition-all duration-200")
                       div.contenedor-imagen
                         if foto.imagenes && foto.imagenes.length > 0
                           img(src=foto.imagenes[0].url_imagen alt=foto.titulo class="w-full h-auto block")
                         else
                           div(class="w-full h-48 bg-gray-200 flex items-center justify-center text-gray-500") Sin imagen

                       div(class="p-3")
                         h4(class="m-0 mb-1 font-bold text-gray-800")= foto.titulo

                         p(class="m-0 text-sm text-gray-500") Por: #{foto.Usuario ? foto.Usuario.nombre_usuario : 'Desconocido'}
                         if foto.etiquetas
                           div(class="mt-2 flex flex-wrap gap-1")
                             each etiqueta in foto.etiquetas
                               span(class="px-2 py-1 bg-gray-100 text-xs text-gray-600 rounded-full")= etiqueta.nombre
                 else
                   div(class="w-full text-center p-12 text-gray-500")
                     h2(class="text-xl font-semibold") No hay resultados
                     p No se encontraron fotos con los filtros seleccionados.