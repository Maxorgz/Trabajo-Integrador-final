extends layout

block metadata
  title Fotaza Login
  script(src="https://cdn.tailwindcss.com")
block content

  div(class="flex flex-wrap m-1 items-center justify-center min-h-screen")

    div(class="w-full md:w-1/2 lg:w-7/12 my-5 px-4")
      
      h1#prueba(class="w-full mx-4 my-2 text-4xl font-bold text-white") Imágenes que cuentan

      h4#encabezado(class="w-full mx-4 my-2 hidden sm:block text-xl text-gray-300") ¡Regístrate ahora!

      div(class="w-full mx-4 my-5")
        button.cssbuttons-io-button(type="button")
          | Empieza Hoy!
          div.icon
            a(href="/register")
              svg(width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg")
                path(fill="currentColor" d="M16.172 11l-5.364-5.364 1.414-1.414L20 12l-7.778 7.778-1.414-1.414L16.172 13H4v-2z")

    div(class="w-full md:w-1/2 lg:w-5/12 my-5 px-1")
      
      div.login-box(class="w-full max-w-md mx-auto my-3 relative")
        
        div(class="absolute top-3 right-5 pt-3 pr-3")
          a(href="/" style="color: inherit; text-decoration: none;" title="Cerrar")
            svg(width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg")
              path(fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z")

        h2(class="my-4 text-white text-2xl font-semibold") Iniciar sesión

        form(action="/auth/login" method="post")
          div.user-box.my-5
            input(type="email" name="email" required)
            label Mail  

          div.user-box.my-4
            input(type="password" name="password" required)
            label Contraseña

          div#contain-login-register.my-5
            a#login-register(class="text-gray-400 hover:text-gray-200 transition" href="/register") ¿No tienes una cuenta? Registrate

          button#submit-login(type="submit") ENVIAR