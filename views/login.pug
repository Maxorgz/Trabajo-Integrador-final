extends layout

block content

  div.row.m-1

    div.col-lg-7.col-md-6.col-sm-5.col-xs-12.my-5
      
      h1.col-lg-12.col-md-12.col-sm-12.col-xs-12.mx-4.my-2#prueba Imágenes que cuentan

      h4.col-lg-6.col-md-12.col-sm-10.col-xs-12.mx-4.my-0.d-none.d-sm-block#encabezado ¡Regístrate ahora!

      div.col-lg-12.col-md-12.col-sm-12.col-xs-12.mx-4.my-5
        button.cssbuttons-io-button(type="button")
          | Empieza Hoy!
          div.icon
            a(href="unauthenticated/fotaza")
              svg(width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg")
                path(fill="currentColor" d="M16.172 11l-5.364-5.364 1.414-1.414L20 12l-7.778 7.778-1.414-1.414L16.172 13H4v-2z")

    div.col-lg-5.col-md-6.col-sm-7.col-xs-12.my-5
      div.login-box.col-lg-11.col-md-12.col-sm-12.col-xs-12.my-3.relative
        
        
        div.absolute.top-3.right-5.pt-3.pr-3
          a(href="/" style="color: inherit; text-decoration: none;" title="Cerrar")
            svg(width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg")
              path(fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z")


        h2.my-4 Iniciar sesión

        form(action="auth/singIn" method="post")
          div.user-box.my-5
            input(type="email" name="mail" required)
            label Mail  

          div.user-box.my-4
            input(type="password" name="password" required)
            label Contraseña

          div#contain-login-register.my-5
            a#login-register.text-gray-400(href="/register") ¿No tienes una cuenta? Registrate

          button#submit-login(type="submit") ENVIAR