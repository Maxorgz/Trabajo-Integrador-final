extends layout

block metadata
  title Fotaza Login
  script(src="https://cdn.tailwindcss.com")

block content
  //- 1. CONTENEDOR PRINCIPAL: Imagen de fondo, cubriendo toda la pantalla
  div(class="relative flex flex-wrap items-center justify-center min-h-screen bg-[url('https://images.unsplash.com/photo-1554034483-04fda0d3507b?q=80&w=1920&auto=format&fit=crop')] bg-cover bg-center bg-no-repeat bg-fixed")
    
    //- 2. OVERLAY: Capa semitransparente oscura para mejorar el contraste del texto
    div(class="absolute inset-0 bg-gray-900/70 z-0")

    //- 3. CONTENIDO: Envolvemos todo en un div relativo para que quede por encima del overlay
    div(class="relative z-10 flex flex-wrap w-full items-center justify-center max-w-7xl mx-auto p-4")

      //- Columna Izquierda (Textos)
      div(class="w-full md:w-1/2 lg:w-7/12 my-5 px-4")
        h1#prueba(class="w-full mx-4 my-2 text-5xl font-bold text-white drop-shadow-lg") Imágenes que cuentan
        h4#encabezado(class="w-full mx-4 my-2 hidden sm:block text-xl text-gray-200") ¡Regístrate ahora!

        div(class="w-full mx-4 my-5")
          button.cssbuttons-io-button(type="button" class="transition hover:scale-105")
            | Empieza Hoy!
            div.icon
              a(href="/register" class="flex items-center justify-center")
                svg(width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg")
                  path(fill="currentColor" d="M16.172 11l-5.364-5.364 1.414-1.414L20 12l-7.778 7.778-1.414-1.414L16.172 13H4v-2z")

      //- Columna Derecha (Formulario)
      div(class="w-full md:w-1/2 lg:w-5/12 my-5 px-1")
        
        //- 4. GLASSMORPHISM: Fondo translúcido, desenfoque (blur), bordes sutiles y sombra
        div.login-box(class="w-full max-w-md mx-auto my-3 relative bg-white/10 backdrop-blur-md border border-white/20 p-8 rounded-2xl shadow-2xl")
          
          div(class="absolute top-3 right-4 pt-3 pr-3 hover:text-cyan-400 transition-colors text-white")
            a(href="/" style="color: inherit; text-decoration: none;" title="Cerrar")
              svg(width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg")
                path(fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z")

          h2(class="my-4 text-white text-3xl font-semibold tracking-wide") Iniciar sesión

          form(action="/auth/login" method="post")
            div.user-box.my-6
              input#email(type="email" name="email" required class="w-full bg-transparent border-b border-gray-400 text-white outline-none focus:border-cyan-400 focus:border-b-2 py-2 transition-all [&:-webkit-autofill]:transition-colors [&:-webkit-autofill]:duration-[5000s] [&:-webkit-autofill]:ease-in-out [&:-webkit-autofill]:[-webkit-text-fill-color:#fff]")
              label(class="text-gray-300 text-sm mt-1 block") Correo Electrónico  

            div.user-box.my-6
              input(type="password" name="password" required class="w-full bg-transparent border-b border-gray-400 text-white outline-none focus:border-cyan-400 focus:border-b-2 py-2 transition-all")
              label(class="text-gray-300 text-sm mt-1 block") Contraseña

            div#contain-login-register.my-6
              a#login-register(class="text-cyan-400 hover:text-cyan-300 hover:underline transition text-sm" href="auth/register") ¿No tienes una cuenta? Regístrate

            button#submit-login(type="submit" class="w-full bg-cyan-600 hover:bg-cyan-500 text-white font-bold py-3 px-4 rounded-lg transition-colors mt-4 shadow-lg") ENVIAR