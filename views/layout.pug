doctype html
html
  head

    meta(charset="UTF-8")
    meta(http-equiv="X-UA-Compatible" content="IE=edge")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    script(src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4")
    block metadata

    script(src="/socket.io/socket.io.js")
    script(src="home.js")
    script(src="login.js")

    link(rel='stylesheet' href='./stylesheets/index.css')
    


  body
    header.bg-slate-800.shadow-lg.border-b.border-slate-700
      nav.px-4.py-4.flex.flex-grow.justify-between.items-center
        div.flex.items-center.gap-5.text-lg.font-bold.text-white.tracking-wide
          a(href="/unauthenticated/fotaza").text-slate-300.hover_text-white.transition Galería
          a(href="/login").text-slate-300.hover_text-white.transition Iniciar Sesión
          a(href="/register").text-slate-300.hover_text-white.transition Registrarse
            
    block content






