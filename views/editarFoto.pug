extends layout

block metadata
  title Editar Publicación
  script(src="https://cdn.tailwindcss.com")

block content 
  div(class="w-full flex justify-center py-10")
    div(class="w-full max-w-2xl bg-gray-900 border border-gray-700 p-8 rounded-2xl shadow-2xl relative")
      
      div(class="absolute top-3 right-5 pt-3 pr-3")
        a(href=`/publicacion/${foto.id}` class="text-gray-400 hover:text-white transition-colors" title="Cancelar")
          svg(width="24" height="24" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg")
            path(fill="currentColor" d="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z")

      h2(class="text-3xl font-bold text-white text-center mb-8") ✏️ Editar Publicación
       
      form(action=`/publicacion/${foto.id}/editar` method="POST" class="flex flex-col gap-6")
        
        div(class="flex flex-col")
          label(for="titulo" class="font-bold text-gray-300 mb-2") Título de la foto:
          input(type="text" name="titulo" id="titulo" value=foto.titulo minlength="3" maxlength="150" required class="w-full p-3 bg-black/50 border border-gray-600 text-white rounded-xl focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 transition-colors")

        div(class="flex flex-col")
          label(for="descripcion" class="font-bold text-gray-300 mb-2") Descripción:
          textarea(name="descripcion" id="descripcion" rows="5" class="w-full p-3 bg-black/50 border border-gray-600 text-white rounded-xl focus:outline-none focus:border-cyan-500 focus:ring-1 focus:ring-cyan-500 resize-none transition-colors")= foto.descripcion

        div(class="mt-4 p-4 bg-cyan-900/20 border border-cyan-800 rounded-xl flex items-start gap-3")
          span(class="text-xl") 💡
          p(class="text-sm text-cyan-200/70 m-0 leading-relaxed") Solo puedes modificar el título y la descripción. Si deseas cambiar la foto o las etiquetas, te sugerimos eliminar esta publicación y crear una nueva.

        button(type="submit" class="mt-6 bg-cyan-600 hover:bg-cyan-500 text-white font-bold py-3 px-4 rounded-xl transition-colors shadow-lg shadow-cyan-900/50 w-full") Guardar Cambios