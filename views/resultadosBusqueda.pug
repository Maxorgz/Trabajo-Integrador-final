extends layout

block metadata
  title Resultados para "#{query}"

block content

  div(class="w-full px-4 sm:px-6 lg:px-8 py-8 font-sans text-gray-200")
        
    div(class="max-w-6xl mx-auto")
      
      div(class="mb-8 border-b border-gray-800 pb-5")
        h1(class="text-3xl font-extrabold text-white mb-2 tracking-tight m-0") Resultados para: 
          span(class="text-cyan-400 font-bold") "#{query}"
        p(class="text-gray-400 text-sm mt-1 m-0") 
          | Mostrando resultados en 
          span(class="font-semibold text-gray-300 capitalize") #{tipo} 
          | &middot; #{resultados.length} encontrados

      //sin resultado
      if resultados.length === 0
        div(class="w-full flex flex-col items-center justify-center py-20 px-4 mt-10 bg-gray-900/30 rounded-3xl border border-gray-800/60 shadow-inner text-center")
         
          if tipo === 'publicaciones'
            span(class="text-7xl mb-6 drop-shadow-lg") 📭
            h3(class="text-2xl font-bold text-white mb-3 m-0") No hay fotos a la vista
            p(class="text-gray-400 text-base max-w-md m-0 mb-8") Parece que nadie ha subido publicaciones con esas palabras. Intentá buscar algo diferente.
            a(href="/" class="inline-flex items-center gap-2 px-6 py-3 bg-cyan-600 hover:bg-cyan-500 text-white font-semibold rounded-xl transition-all shadow-lg hover:shadow-cyan-500/30 no-underline hover:-translate-y-1")
              svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")
              | Seguir explorando
          
          if tipo === 'personas'
            span(class="text-7xl mb-6 drop-shadow-lg") 🕵️‍♂️
            h3(class="text-2xl font-bold text-white mb-3 m-0") Usuario no encontrado
            p(class="text-gray-400 text-base max-w-md m-0") No tenemos a nadie registrado con ese nombre exacto. Verificá si lo escribiste bien.

      //resultado publi
      if tipo === 'publicaciones' && resultados.length > 0
        div(class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6")
          each pub in resultados
            a(href=`/foto/${pub.id}` class="group flex flex-col bg-gray-900 rounded-2xl overflow-hidden border border-gray-800 hover:border-cyan-500 transition-all duration-300 shadow-md hover:shadow-cyan-500/20 text-decoration-none hover:-translate-y-1")
              
             
              div(class="w-full aspect-square bg-black relative overflow-hidden flex items-center justify-center")
                if pub.imagenes && pub.imagenes.length > 0
                  img(src=pub.imagenes[0].url_imagen alt=pub.titulo class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-700 opacity-90 group-hover:opacity-100")
                else
                  span(class="text-gray-600 text-sm") Sin imagen
              
              //info
              div(class="p-4 flex flex-col flex-1")
                h3(class="text-base font-bold text-gray-100 truncate m-0 mb-1")= pub.titulo
                p(class="text-xs text-gray-500 m-0 truncate mt-auto") Por 
                  span(class="text-gray-300 font-medium") #{pub.Usuario ? pub.Usuario.nombre_usuario : 'Desconocido'}

      //resultados
      if tipo === 'personas' && resultados.length > 0
        div(class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-6")
          each persona in resultados
            div(class="bg-gray-900 rounded-2xl p-6 border border-gray-800 hover:border-cyan-500/50 transition-all flex flex-col items-center text-center shadow-md group")
              
              
              div(class="w-20 h-20 rounded-full bg-gradient-to-tr from-gray-800 to-gray-700 group-hover:from-cyan-600 group-hover:to-blue-700 flex items-center justify-center text-white font-bold text-3xl shadow-inner mb-4 transition-colors duration-500")
                | #{persona.nombre_usuario.charAt(0).toUpperCase()}
              
              h3(class="text-lg font-bold text-gray-200 m-0 mb-4 truncate w-full")= persona.nombre_usuario
              
              button(disabled class="w-full py-2.5 bg-gray-800/50 text-cyan-500 text-sm font-semibold rounded-xl border border-gray-700 cursor-not-allowed opacity-70") Perfil