extends layout

block content
  //Contenedor principal
  div(class="max-w-[1000px] mx-auto my-10 p-5")
    
    h2(class="text-white text-center mb-8 text-3xl font-bold") Mi Perfil

    //Seguidores
    div(class="flex justify-center gap-8 my-6 text-lg text-gray-400")
      div
        strong(class="text-white") #{cantSeguidores} 
        | Seguidores
      div
        strong(class="text-white") #{cantSeguidos} 
        | Seguidos

    //Galería de fotos
    if fotos && fotos.length > 0
      div.galeria(class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6")
        each foto in fotos
          
          
          div.tarjeta-foto(class="relative rounded-lg overflow-hidden shadow-md bg-gray-800 border border-gray-700 hover:shadow-cyan-500/20 hover:shadow-lg transition-all duration-300")
            
            a(href=`/foto/${foto.id}` class="block no-underline text-inherit")
              div.contenedor-imagen
                if foto.imagenes && foto.imagenes.length > 0
                  img(src=foto.imagenes[0].url_imagen alt=foto.titulo class="w-full h-[350px] object-cover object-center")
              
              div.info-foto(class="p-4")
                h4(class="m-0 text-white text-lg font-semibold")= foto.titulo
                if foto.descripcion
                  p(class="mt-2 mb-0 text-gray-300 text-sm line-clamp-2")= foto.descripcion
                else
                  p(class="mt-2 mb-0 text-gray-500 text-sm italic") Sin descripción
                  
           
            div(class="flex justify-between items-center px-4 py-3 bg-gray-900/50 border-t border-gray-700")
              a(href=`/publicacion/${foto.id}/editar` class="text-cyan-400 font-bold hover:text-cyan-300 transition-colors") Editar
              
              form(action=`/publicacion/${foto.id}/eliminar` method="POST" onsubmit="return confirm('¿Estás seguro de que quieres eliminar esta foto para siempre?');" class="m-0")
                button(type="submit" class="bg-transparent border-none text-red-500 font-bold cursor-pointer hover:text-red-400 transition-colors") Eliminar
    
    else
      
      div(class="text-center p-10 bg-gray-800/50 border border-gray-700 rounded-lg shadow-sm max-w-2xl mx-auto")
        h3(class="text-gray-300 text-xl font-medium") Aún no hay fotos subidas.
        a(href="/nuevaFoto" class="mt-5 inline-block px-6 py-2 bg-cyan-600 text-white rounded-md hover:bg-cyan-500 transition-colors font-semibold") ¡Sube tu primera Fotaza!