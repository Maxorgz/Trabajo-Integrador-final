extends layout

block content
  div(style="max-width: 1000px; margin: 40px auto; padding: 20px;")
    h2(style="color: #8a5a44; text-align: center; margin-bottom: 30px;") Mi Perfil

    div(style="display: flex; justify-content: center; gap: 30px; margin: 20px 0; font-size: 1.1em; color: #555; margin-bottom: 25px;")
      div
        strong #{cantSeguidores} 
        | Seguidores
      div
        strong #{cantSeguidos} 
        | Seguidos

    if fotos && fotos.length > 0
      div.galeria
        each foto in fotos
          div.tarjeta-foto(style="position: relative; border-radius: 8px; overflow: hidden; box-shadow: 0 2px 5px rgba(0,0,0,0.1); margin-bottom: 20px; background: #fff;")
            
            a(href=`/foto/${foto.id}` style="text-decoration: none; color: inherit;")
              div.contenedor-imagen
                if foto.imagenes && foto.imagenes.length > 0
                  img(src=foto.imagenes[0].url_imagen alt=foto.titulo style="width: 100%; height: 350px; object-fit: cover; object-position: center;")
              div.info-foto(style="padding: 15px;")
                h4(style="margin: 0; color: #333;")= foto.titulo
                if foto.descripcion
                  p(style="margin: 8px 0 0 0; color: #666; font-size: 0.9em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;")= foto.descripcion
                else
                  p(style="margin: 8px 0 0 0; color: #aaa; font-size: 0.9em; font-style: italic;") Sin descripcion
                  
            div(style="display: flex; justify-content: space-between; align-items: center; padding: 10px 15px; background: #faf4ed; border-top: 1px solid #eee;")
              a(href=`/publicacion/${foto.id}/editar` style="color: #f39c12; text-decoration: none; font-weight: bold;") Editar
              
              form(action=`/publicacion/${foto.id}/eliminar` method="POST" onsubmit="return confirm('¿Estás seguro de que quieres eliminar esta foto para siempre?');" style="margin: 0;")
                button(type="submit" style="background: none; border: none; color: #cc0000; font-weight: bold; cursor: pointer;") Eliminar
    else
      div(style="text-align: center; padding: 40px; background: #fff; border-radius: 8px;")
        h3(style="color: #666;") Aun no hay fotos subidas.
        a.btn-oscuro(href="/nuevaFoto" style="margin-top: 20px; display: inline-block;") ¡Sube tu primera Fotaza!