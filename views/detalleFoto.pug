extends layout

block metadata
  title Detalle de fotos 

block content
  //Contenedor principal centrado 
  div(class="max-w-5xl mx-auto my-8 p-4 md:p-8 bg-gray-900 rounded-xl shadow-2xl text-gray-200")
    
    //Aviso para invitados
    if !usuario
      div(class="bg-yellow-900/40 border border-yellow-700/50 text-yellow-300 p-4 rounded-lg mb-8 text-center font-medium shadow-sm")
        p(class="m-0") Estás viendo esto como invitado. Inicia sesión para dar like, comentar o ver otras opciones.

    div(class="space-y-6")
      
      //Autor
      p(class="text-gray-400 text-sm m-0") Publicado por: 
        span(class="font-bold text-white text-base") #{foto.Usuario ? foto.Usuario.nombre_usuario : 'Desconocido'}

      // Carrusel
      div(class="relative w-full h-[400px] md:h-[600px] bg-black rounded-xl overflow-hidden flex items-center justify-center shadow-inner group")
        if foto.imagenes && foto.imagenes.length > 0
          if foto.imagenes.length > 1
            //- Botones del carrusel (Aparecen más visibles al pasar el mouse por el contenedor)
            button(onclick="cambiarImagen(-1)" class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/90 text-white w-10 h-10 rounded-full z-20 transition-all opacity-70 group-hover:opacity-100 flex items-center justify-center text-xl") &#10094;
            button(onclick="cambiarImagen(1)" class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/50 hover:bg-black/90 text-white w-10 h-10 rounded-full z-20 transition-all opacity-70 group-hover:opacity-100 flex items-center justify-center text-xl") &#10095;
          
          each imagen, index in foto.imagenes
            //- Mantenemos tus clases JS intactas (.carrusel-slide y .activo)
            div(class=`${index === 0 ? "activo" : ""} w-full h-full flex justify-center items-center absolute inset-0`)
              img(src=imagen.url_imagen alt=foto.titulo class="max-w-full max-h-full object-contain")

      //Etiquetas
      if foto.etiquetas && foto.etiquetas.length > 0
        div(class="flex flex-wrap gap-2 mt-6")
          each etiqueta in foto.etiquetas
            span(class="bg-[#8a5a44] text-white text-xs font-semibold px-3 py-1.5 rounded-full shadow-sm")= etiqueta.nombre

      //Descripción y Fecha
      if foto.descripcion
        p(class="text-gray-300 mt-4 leading-relaxed text-lg")= foto.descripcion
      p(class="text-gray-500 text-sm mt-2 font-medium") Publicado el: #{foto.createdAt ? new Date(foto.createdAt).toLocaleString('es-AR', { hour12: false }) : 'Fecha no disponible'}

      //Likes y Promedio
      div(class="mt-6 inline-flex flex-wrap items-center gap-x-6 gap-y-2 bg-gray-800 border border-gray-700 px-5 py-3 rounded-lg shadow-sm")
        span(class="font-bold text-cyan-400 text-lg") ❤️ #{totalLikes} Me gusta
        span(class="font-bold text-amber-400 text-lg") ⭐ Promedio: #{promedio} 
        span(class="text-gray-400 text-sm font-medium") (#{totalVotosPuntaje} valoraciones)

      //Likes, Votos, Me Interesa
      div(class="mt-8 flex flex-wrap gap-4 items-center")
        if usuario
          if usuario.id !== foto.usuario_id
            form(action=`/publicacion/${foto.id}/like` method="POST" class="m-0")
              button(type="submit" class="px-5 py-2.5 bg-cyan-600 hover:bg-cyan-500 text-white font-semibold rounded-lg transition-colors shadow-sm") Me gusta
            
            form(action=`/publicacion/${foto.id}/valorar` method="POST" class="m-0 flex gap-2")
              select(name="puntaje" required class="px-3 py-2.5 bg-gray-800 border border-gray-600 text-white rounded-lg focus:ring-2 focus:ring-cyan-500 outline-none cursor-pointer")
                option(value="" disabled selected) Calificar...
                option(value="5") 5 ⭐
                option(value="4") 4 ⭐
                option(value="3") 3 ⭐
                option(value="2") 2 ⭐
                option(value="1") 1 ⭐
              button(type="submit" class="px-5 py-2.5 bg-gray-700 hover:bg-gray-600 border border-gray-600 text-white font-semibold rounded-lg transition-colors shadow-sm") Enviar Voto
            
            form(action=`/publicacion/${foto.id}/me-interesa` method="POST" class="m-0")
              button(type="submit" class="px-5 py-2.5 bg-green-600 hover:bg-green-500 text-white font-semibold rounded-lg transition-colors shadow-sm") Me interesa
          
          else 
            a(href=`/publicacion/${foto.id}/editar` class="px-6 py-2.5 bg-[#f39c12] hover:bg-orange-500 text-white font-semibold rounded-lg transition-colors shadow-sm no-underline inline-block") Editar
        
        else
          //botones deshabilitados para invitados
          button(disabled class="px-5 py-2.5 bg-cyan-900 text-cyan-500 font-semibold rounded-lg opacity-60 cursor-not-allowed") Me gusta
          div(class="flex gap-2")
            select(disabled class="px-3 py-2.5 bg-gray-800 border border-gray-700 text-gray-500 rounded-lg opacity-60 cursor-not-allowed")
              option(value="" disabled selected) Calificar...
          button(disabled class="px-5 py-2.5 bg-green-900 text-green-500 font-semibold rounded-lg opacity-60 cursor-not-allowed") Me interesa


      //Comentarios
      div(class="mt-12 pt-8 border-t border-gray-700")
        h3(class="text-2xl font-bold text-white mb-6") Comentarios

        if foto.comentarios && foto.comentarios.length > 0
          div(class="space-y-4")
            each comentario in foto.comentarios
              div.comentario(class="bg-gray-800 p-5 rounded-xl border border-gray-700 shadow-sm")
                div(class="flex justify-between items-center mb-2")
                  strong(class="text-cyan-400 text-lg")= comentario.Usuario.nombre_usuario
                  span(class="text-gray-500 text-xs font-medium") #{new Date(comentario.createdAt).toLocaleString('es-AR', { hour12: false})}
                
                p(class="text-gray-200 m-0 leading-relaxed")= comentario.texto
                
        else
          p(class="text-gray-400 italic mb-8") Aún no hay comentarios. Sé el primero en opinar.
        
        //Caja para publicar nuevo comentario
        if usuario
          form(action=`/publicacion/${foto.id}/comentar` method="POST" class="mt-8 bg-gray-800 p-1 sm:p-5 rounded-xl border border-gray-700 shadow-sm")
            textarea(name="texto" required placeholder="Escribe un comentario..." rows="3" class="w-full p-4 bg-gray-900 border border-gray-600 text-white rounded-lg mb-4 focus:ring-2 focus:ring-cyan-500 outline-none resize-y")
            div(class="flex justify-end")
              button(type="submit" class="px-6 py-3 bg-cyan-600 hover:bg-cyan-500 text-white font-bold rounded-lg transition-colors shadow-sm") Publicar Comentario
        else
          div(class="mt-8 p-5 border border-gray-700 rounded-xl bg-gray-800/50 text-center")
            p(class="text-gray-400 m-0") 
              a(href="/login" class="text-cyan-400 hover:underline font-semibold") Inicia sesión
              |  para publicar un comentario.


block scripts  
  script.
      let slideIndex = 0;

      function cambiarImagen(direccion) {
        const slides = document.querySelectorAll('.carrusel-slide');
        
        if (slides.length === 0) return;

        slides[slideIndex].classList.remove('activo');
        
        slideIndex += direccion;
        
        if (slideIndex >= slides.length) {
          slideIndex = 0;
        } else if (slideIndex < 0) {
          slideIndex = slides.length - 1;
        }
        
        slides[slideIndex].classList.add('activo');
      }