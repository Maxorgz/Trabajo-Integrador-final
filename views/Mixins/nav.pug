
nav(class="sticky top-0 z-50 w-full bg-[#0B0F19]/80 backdrop-blur-md border-b border-gray-800 shadow-sm min-w-max")
  div(class="max-w-screen-2xl mx-auto px-8")
    div(class="flex justify-between items-center h-16")
      
      div(class="flex items-center gap-8")
        
        //- Logo / Marca
        a(href="/" class="flex items-center gap-2 group decoration-none")
          div(class="bg-cyan-500/10 p-2 rounded-lg text-cyan-400 group-hover:bg-cyan-500 group-hover:text-white transition-all duration-300 shadow-[0_0_15px_-3px_rgba(6,182,212,0.3)]")
            svg(class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z")
          span(class="text-xl font-bold bg-gradient-to-r from-cyan-400 to-blue-500 bg-clip-text text-transparent tracking-wide") Fotaza
        
        //links
        div(class="flex items-center gap-6")
          a(href="/" class="text-gray-300 hover:text-cyan-400 text-sm font-medium transition-colors no-underline") Inicio
          a(href="/explorar" class="text-gray-300 hover:text-cyan-400 text-sm font-medium transition-colors no-underline") Explorar

      div(class="flex-1 max-w-xl mx-8")
        //formulario buscar
        form(action="/buscar" method="GET" class="relative flex items-center")
          
          //tipo de busqueda
          select(name="tipo" class="absolute left-0 h-full py-0 pl-3 pr-8 bg-transparent text-gray-400 text-sm font-medium border-transparent focus:ring-0 focus:border-transparent outline-none cursor-pointer appearance-none z-10")
            option(value="publicaciones" class="bg-gray-800 text-white") Fotos
            option(value="personas" class="bg-gray-800 text-white") Usuarios
          
          
          div(class="absolute left-16 text-gray-500 pointer-events-none z-10")
            svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7")
          
          
          div(class="absolute left-24 h-5 w-px bg-gray-600 z-10")

          //buscar
          input(type="text" name="q" placeholder="Buscar..." required class="w-full pl-28 pr-10 py-2 bg-gray-900/50 border border-gray-700 focus:border-cyan-500 rounded-full text-sm text-white placeholder-gray-500 outline-none transition-all focus:ring-1 focus:ring-cyan-500 shadow-inner")
          
          //Lupa
          button(type="submit" class="absolute right-3 text-gray-400 hover:text-cyan-400 transition-colors")
            svg(class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z")

      //usuario
      div(class="flex items-center gap-4 shrink-0")
        if usuario
          //Btn Foto
          a(href="/nuevaFoto" class="flex items-center gap-2 px-4 py-2 bg-gray-800 hover:bg-gray-700 border border-gray-700 hover:border-cyan-500 text-white text-sm font-medium rounded-lg transition-all shadow-sm no-underline")
            svg(class="w-4 h-4 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24")
              path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4")
            | Nueva Foto
          
          //perfil usuario
          div(class="flex items-center gap-3 pl-5 ml-2 border-l border-gray-700")
            span(class="text-sm font-medium text-gray-300") Hola, 
              strong(class="text-white") #{usuario.nombre_usuario}
            div(class="w-9 h-9 rounded-full bg-gradient-to-tr from-cyan-500 to-blue-600 flex items-center justify-center text-white font-bold text-sm shadow-md cursor-pointer border border-gray-800")
              | #{usuario.nombre_usuario.charAt(0).toUpperCase()}
            
            //btn Salir
            a(href="/auth/logout" class="ml-2 text-gray-500 hover:text-red-500 transition-colors bg-gray-900 hover:bg-gray-800 p-2 rounded-lg" title="Cerrar sesión")
              svg(class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24")
                path(stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1")
        
        else
          //btn Invitados
          a(href="/auth/login" class="text-gray-300 hover:text-white text-sm font-medium transition-colors no-underline") Iniciar sesión
          a(href="/auth/register" class="px-5 py-2.5 bg-cyan-600 hover:bg-cyan-500 text-white text-sm font-bold rounded-xl transition-all shadow-lg shadow-cyan-500/20 hover:shadow-cyan-500/40 no-underline") Regístrate